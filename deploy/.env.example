# Copy to .env beside this file and fill in. Nothing here is a secret; .env is.

# The domain Caddy gets a certificate for and serves the office on.
# Use localhost to try the kit on this machine — Caddy issues its own.
VO_DOMAIN=

# The one token that reaches this office. Anybody holding it can read and change
# everything in it, so make it long and keep it out of version control.
#   openssl rand -base64 32
VO_API_TOKEN=

# Which office the worker works for. An office is made with one POST (see
# README.md); until this is set the worker ticks and reports that it cannot
# read one.
VO_OFFICE_ID=

# Where a canvas may call from, comma separated. Empty means servers only, so a
# browser cannot reach the office at all.
#   https://office.example.com,http://localhost:5173
VO_ALLOWED_ORIGINS=

# What the employees think with. Without it, set VO_DRY_RUN instead.
ANTHROPIC_API_KEY=

# Set to anything to rehearse: the office runs its work and no model is called.
VO_DRY_RUN=
